# Database
DATABASE_URL=mysql://root:password@localhost:3306/socialcrm_agents

# JWT
JWT_SECRET=seu-secret-super-seguro-aqui-min-32-caracteres

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx

# Mercado Pago
MERCADO_PAGO_API_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxx

# Redis (para cache)
REDIS_URL=redis://localhost:6379

# API URL
VITE_API_URL=http://localhost:3000
API_PORT=3000

# Environment
NODE_ENV=development

# WhatsApp
WHATSAPP_BUSINESS_ID=xxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxx

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
