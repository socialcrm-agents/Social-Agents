# Copie para .env e preencha (nunca faça commit do .env).
# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=                    # token permanente de um System User com whatsapp_business_messaging
WA_PHONE_NUMBER_ID=          # id do número (WhatsApp Manager > API Setup)
WA_VERIFY_TOKEN=             # qualquer texto; o mesmo vai no cadastro do webhook
WA_APP_SECRET=               # segredo do app: valida a assinatura X-Hub-Signature-256 dos POSTs
WA_API_VERSION=v23.0
# --- Claude API (cérebro) ---
ANTHROPIC_API_KEY=           # sem chave o editor roda só com as regras automáticas
EDITOR_MODELO=claude-opus-5-5
EDITOR_EFFORT=medium
# --- Serviço ---
PUBLIC_URL=                  # https://seu-dominio (link quando o vídeo passa de 15 MB)
EDITOR_DATA_DIR=./dados
EDITOR_ESTILO=reels_viral
CREDITOS_GRATIS=2            # vídeos grátis para número novo
CORRECOES_POR_VIDEO=3
APAGAR_APOS_DIAS=7           # privacidade: vídeos e projetos são apagados depois disso
